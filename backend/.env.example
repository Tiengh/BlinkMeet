NODE_ENV=development
PORT=5001
MONGO_URL=mongodb://localhost:27017/blinkmeet
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=blinkmeet

# Development-only value. Replace with a random secret in production.
JWT_SECRET_KEY=blinkmeet-local-jwt-secret-change-me
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb
SOCKET_MAX_PAYLOAD_BYTES=131072
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_MS=60000
FRIEND_REQUEST_RATE_LIMIT=10
FRIEND_REQUEST_RATE_WINDOW_MS=60000
MATCHMAKING_RATE_LIMIT=20
MATCHMAKING_RATE_WINDOW_MS=60000
ICE_CONFIG_RATE_LIMIT=30
ICE_CONFIG_RATE_WINDOW_MS=60000
SOCKET_IP_CONNECTION_RATE_LIMIT=120
SOCKET_IP_CONNECTION_RATE_WINDOW_MS=60000
SOCKET_CONNECTION_RATE_LIMIT=20
SOCKET_CONNECTION_RATE_WINDOW_MS=60000

STREAM_API_KEY=
STREAM_API_SECRET=
WEBRTC_STUN_URLS=stun:localhost:3478
WEBRTC_TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
WEBRTC_ICE_TRANSPORT_POLICY=all
TURN_EXTERNAL_IP=127.0.0.1
# Development-only local Coturn secret. Replace with a random secret in production.
TURN_SHARED_SECRET=blinkmeet-local-turn-secret
TURN_CREDENTIAL_TTL_SECONDS=3600

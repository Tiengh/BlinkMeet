# Copy to dev.env (gitignored), then fill in non-secret identifiers.
BLINKMEET_DEV_ACCOUNT_ID=123456789012
BLINKMEET_DEV_REGION=ap-southeast-1
BLINKMEET_DEV_AZS=ap-southeast-1a,ap-southeast-1b
BLINKMEET_DEV_IMAGE_TAG=git-0123456789abcdef
BLINKMEET_DEV_API_DOMAIN=api.dev.example.com
BLINKMEET_DEV_FRONTEND_DOMAIN=app.dev.example.com
BLINKMEET_DEV_API_CERTIFICATE_ARN=arn:aws:acm:ap-southeast-1:123456789012:certificate/replace-me
BLINKMEET_DEV_FRONTEND_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/replace-me
BLINKMEET_DEV_JWT_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:replace-AbCdEf
# Optional legacy friend-call Stream integration:
# BLINKMEET_DEV_STREAM_API_KEY=replace-me
# BLINKMEET_DEV_STREAM_API_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:replace-AbCdEf
# Optional externally deployed TURN endpoint:
# BLINKMEET_DEV_TURN_URLS=turn:turn.dev.example.com:3478?transport=udp,turn:turn.dev.example.com:3478?transport=tcp
# BLINKMEET_DEV_TURN_EXTERNAL_IP=203.0.113.10
# BLINKMEET_DEV_TURN_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:replace-AbCdEf

# Docker Compose Phase 8 defaults for local development.
# Replace the secret before exposing coturn outside your machine.
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_REALM=blinkmeet.local

# Browser-reachable TURN hostname/IP. localhost works for two browsers on
# this machine; use the host LAN IP when testing from another device.
TURN_PUBLIC_HOST=localhost

# Public/LAN IP coturn advertises in relay candidates.
TURN_EXTERNAL_IP=127.0.0.1

TURN_CREDENTIAL_TTL_SECONDS=3600

# all = prefer direct P2P and fall back to TURN
# relay = force TURN for verification
WEBRTC_ICE_TRANSPORT_POLICY=all
